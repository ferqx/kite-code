{
  "name": "@kite-ai/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.tsx"
  },
  "scripts": {
    "build": "node --import ../../scripts/tooling/register.mjs ../../scripts/tooling/build-command.ts ./src/index.tsx --target=browser --packages=external --outdir=dist",
    "build:native": "node --import ../../scripts/tooling/register.mjs scripts/build-native.ts",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node --import ../../scripts/tooling/register.mjs ../../scripts/run-test-files.ts ./test"
  },
  "dependencies": {
    "@kite-ai/agent": "workspace:*",
    "@kite-ai/client": "workspace:*",
    "@kite-ai/service": "workspace:*",
    "@kite-ai/ui": "workspace:*",
    "react-dom": "19.2.7",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "shadcn": "4.21.0",
    "@kite-ai/trajectory": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "playwright": "1.63.0",
    "react": "^19.2.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "vite": "7.3.6",
    "@vitejs/plugin-react": "5.2.0",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}

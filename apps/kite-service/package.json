{
  "name": "@kite-ai/kite-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "./src/index.ts",
  "imports": {
    "#kite-service/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/executable.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun run ../../scripts/run-owned-tests.ts ."
  },
  "dependencies": {
    "@kite-ai/agent-api-contract": "workspace:*",
    "@kite-ai/builtin-runtime": "workspace:*",
    "@kite-ai/kite-app-contract": "workspace:*",
    "@kite-ai/kite-local-runtime": "workspace:*",
    "@kite-ai/runtime-client": "workspace:*",
    "@kite-ai/runtime-contract": "workspace:*",
    "@kite-ai/runtime-host": "workspace:*",
    "@kite-ai/runtime-protocol": "workspace:*",
    "@kite-ai/runtime-server": "workspace:*",
    "@kite-ai/runtime-spi": "workspace:*",
    "@kite-ai/runtime-storage-sqlite": "workspace:*",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.3.6"
  }
}

{
  "name": "@kite-ai/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./paired": "./src/paired.ts",
    "./bootstrap": "./src/bootstrap.ts",
    "./configuration": "./src/configuration.ts",
    "./runtime-assets": "./src/runtime-assets.ts",
    "./native-runtime-assets": "./src/native-runtime-assets.ts",
    "./windows-native-bootstrap": "./src/windows-native-bootstrap.ts",
    "./runtime-protection": "./src/runtime-protection.ts",
    "./sqlite-release-assets": "./src/sqlite-release-assets.ts",
    "./mcp-http-port": "./src/mcp-http-port.ts",
    "./development-web": "./src/development-web.ts",
    "./main": "./src/main.ts",
    "./daemon": "./src/daemon.ts",
    "./daemon-main": "./src/daemon-main.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/paired.ts ./src/main.ts ./src/bootstrap.ts ./src/configuration.ts ./src/runtime-assets.ts ./src/native-runtime-assets.ts ./src/windows-native-bootstrap.ts ./src/runtime-protection.ts ./src/sqlite-release-assets.ts ./src/mcp-http-port.ts ./src/development-web.ts ./src/daemon.ts ./src/daemon-main.ts --target=bun --splitting --packages=bundle --external=@kite-ai/agent --external=@kite-ai/ai --external=@kite-ai/client --external=@kite-ai/trajectory --root=./src --outdir=dist && bun ./src/trace-extensions/engine/build-assets.ts dist && bun ./src/trace-integrations/opentelemetry/build-assets.ts dist",
    "typecheck": "bun check -p tsconfig.json",
    "test": "bun run ../../scripts/run-owned-tests.ts ."
  },
  "dependencies": {
    "@kite-ai/agent": "workspace:*",
    "@kite-ai/ai": "workspace:*",
    "@kite-ai/client": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "4.13.12",
    "zod": "4.3.6",
    "@kite-ai/trajectory": "workspace:*",
    "quickjs-emscripten-core": "0.32.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@opentelemetry/otlp-exporter-base": "0.301.0",
    "@opentelemetry/otlp-transformer": "0.301.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.0",
    "@opentelemetry/resources": "3.1.0"
  },
  "devDependencies": {
    "@kite-ai/trace-extension-sdk": "workspace:*"
  }
}

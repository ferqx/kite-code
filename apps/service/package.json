{
  "name": "@kite-ai/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./paired": "./src/paired.ts",
    "./bootstrap": "./src/bootstrap.ts",
    "./configuration": "./src/configuration.ts",
    "./runtime-assets": "./src/runtime-assets.ts",
    "./native-runtime-assets": "./src/native-runtime-assets.ts",
    "./runtime-protection": "./src/runtime-protection.ts",
    "./sqlite-release-assets": "./src/sqlite-release-assets.ts",
    "./mcp-http-port": "./src/mcp-http-port.ts",
    "./development-web": "./src/development-web.ts",
    "./main": "./src/main.ts",
    "./daemon": "./src/daemon.ts",
    "./daemon-main": "./src/daemon-main.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/paired.ts ./src/main.ts ./src/bootstrap.ts ./src/configuration.ts ./src/runtime-assets.ts ./src/native-runtime-assets.ts ./src/runtime-protection.ts ./src/sqlite-release-assets.ts ./src/mcp-http-port.ts ./src/development-web.ts ./src/daemon.ts ./src/daemon-main.ts --target=bun --packages=external --root=./src --outdir=dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun run ../../scripts/run-owned-tests.ts ."
  },
  "dependencies": {
    "@kite-ai/agent": "workspace:*",
    "@kite-ai/ai": "workspace:*",
    "@kite-ai/client": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "4.13.12",
    "zod": "4.3.6"
  }
}

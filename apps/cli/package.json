{
  "name": "@kite-ai/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./host": "./host/index.ts",
    "./main": "./host/main.ts",
    "./tui-host": "./host/tui.tsx",
    "./tui-main": "./host/tui-main.ts"
  },
  "scripts": {
    "build": "node --import ../../scripts/tooling/register.mjs ../../scripts/tooling/build-command.ts ./src/index.ts ./host/index.ts ./host/main.ts ./host/tui.tsx ./host/tui-main.ts --target=node --packages=external --root=. --outdir=dist",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node --import ../../scripts/tooling/register.mjs ../../scripts/run-test-files.ts ./test"
  },
  "dependencies": {
    "@kite-ai/client": "workspace:*",
    "@kite-ai/agent": "workspace:*",
    "@kite-ai/service": "workspace:*",
    "@kite-ai/ui": "workspace:*",
    "ink": "^7.1.1",
    "ignore": "5.3.2",
    "react": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.14"
  }
}

{
  "name": "@kite-ai/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./assets": {
      "types": "./src/assets-port.ts",
      "default": "./dist/assets.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --target=browser --packages=external --outdir=dist && bun build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test ./test"
  },
  "dependencies": {
    "@kite-ai/client": "workspace:*",
    "@kite-ai/ui": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/jsdom": "^28.0.3",
    "jsdom": "^29.1.1"
  }
}

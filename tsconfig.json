{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["bun"],
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "skipLibCheck": true
  },
  "include": [
    "scripts/check-unified-agent-boundary.ts",
    "scripts/check-unified-workspaces.ts",
    "scripts/generate-unified-api.ts",
    "scripts/run-default-tests.ts",
    "scripts/run-unified-tests.ts",
    "scripts/run-runtime-workspace-script.ts",
    "scripts/run-owned-tests.ts",
    "scripts/run-unified-tui-system-tests.ts",
    "scripts/unified-test-plan.ts",
    "scripts/runtime/unified-soak.ts",
    "scripts/runtime/unified-soak-probe.ts",
    "scripts/runtime/unified-soak-native.ts",
    "scripts/runtime/unified-soak-report.ts",
    "scripts/runtime/unified-soak-verify.ts",
    "scripts/runtime/unified-mcp-live-smoke.ts",
    "scripts/runtime/unified-session-log-acl.ts",
    "scripts/development/ensure-web.ts",
    "scripts/development/unified-cli.ts",
    "scripts/development/unified-tui.ts",
    "scripts/development/unified-web.ts",
    "scripts/release/release-arguments.ts",
    "scripts/release/release-smoke.ts",
    "scripts/release/unified.ts",
    "scripts/release/native.ts",
    "scripts/release/prepare-windows-native-ci.ts",
    "scripts/release/native-archive.ts",
    "scripts/release/native-install.ts",
    "scripts/release/source-terminal.ts",
    "scripts/release/terminal.ts",
    "scripts/release/sqlite-engine.ts",
    "scripts/release/cli-registration.ts",
    "scripts/release/unified-platform-probe.ts",
    "scripts/release/unified-platform-verify.ts",
    "scripts/release/entrypoints/cli.ts",
    "scripts/release/entrypoints/tui.ts",
    "scripts/release/entrypoints/terminal-cli.ts",
    "scripts/release/entrypoints/terminal-tui.ts",
    "scripts/release/entrypoints/registered-entry.ts",
    "scripts/release/entrypoints/standard-cli.ts",
    "scripts/release/entrypoints/standard-tui.ts",
    "scripts/release/entrypoints/native-cli.ts",
    "scripts/release/entrypoints/native-tui.ts",
    "tests/fixtures/unified-agent/**/*.ts",
    "tests/fixtures/extensions/mini-review/**/*.ts",
    "tests/fixtures/extensions/upgrade/**/*.ts",
    "tests/isolated/unified-agent/**/*.ts",
    "tests/integration/docs-structure.test.ts",
    "tests/integration/document-sync-skill.test.ts",
    "tests/integration/scripts/check-test-ownership.test.ts",
    "tests/integration/scripts/test-discovery.test.ts",
    "tests/integration/scripts/unified-workspaces.test.ts",
    "tests/integration/scripts/unified-default-plan.test.ts",
    "tests/integration/scripts/unified-ci.test.ts",
    "tests/isolated/scripts/agent-notes.test.ts",
    "tests/isolated/scripts/check-pre-release-architecture-policy.test.ts",
    "tests/isolated/scripts/docs-impact-scopes.test.ts",
    "tests/isolated/scripts/docs-structure.test.ts",
    "tests/isolated/scripts/test-suite-runner.test.ts",
    "tests/isolated/scripts/unified-agent-boundary.test.ts"
  ]
}

#include <winres.h>
#include <commctrl.h>
#include "resource.h"

IDD_SETUP_WIZARD DIALOGEX 0, 0, 346, 211
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | DS_CENTER | DS_SETFONT
EXSTYLE WS_EX_APPWINDOW
CAPTION "Kite 桌面版安装"
FONT 9, "Segoe UI"
BEGIN
  CONTROL "", IDC_SETUP_ICON, "Static", SS_ICON | SS_CENTERIMAGE, 306, 8, 28, 25
  LTEXT "", IDC_SETUP_HEADING, 11, 6, 284, 14
  LTEXT "", IDC_SETUP_DETAIL, 16, 20, 279, 12
  LTEXT "", IDC_SETUP_PROGRESS_DETAIL, 16, 51, 314, 39
  GROUPBOX "目标文件夹(&D)", IDC_SETUP_LOCATION_GROUP, 16, 113, 314, 38
  EDITTEXT IDC_LOCATION, 27, 128, 219, 13, ES_AUTOHSCROLL | WS_TABSTOP
  PUSHBUTTON "浏览(&B)…", IDC_BROWSE, 254, 127, 63, 14
  LTEXT "", IDC_SETUP_DISK_SPACE, 16, 157, 314, 23
  AUTOCHECKBOX "在桌面上创建 Kite 快捷方式(&S)", IDC_DESKTOP_SHORTCUT, 16, 79, 314, 13, WS_TABSTOP
  PUSHBUTTON "< 上一步(&P)", IDC_SETUP_BACK, 171, 190, 52, 14
  DEFPUSHBUTTON "下一步(&N) >", IDOK, 227, 190, 52, 14
  PUSHBUTTON "取消", IDCANCEL, 283, 190, 52, 14
END

IDD_SETUP_PROGRESS DIALOGEX 0, 0, 346, 211
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | DS_CENTER | DS_SETFONT
EXSTYLE WS_EX_APPWINDOW
CAPTION "Kite 桌面版安装"
FONT 9, "Segoe UI"
BEGIN
  CONTROL "", IDC_SETUP_ICON, "Static", SS_ICON | SS_CENTERIMAGE, 306, 8, 28, 25
  LTEXT "", IDC_SETUP_HEADING, 11, 6, 284, 14
  LTEXT "", IDC_SETUP_DETAIL, 16, 20, 279, 12
  LTEXT "", IDC_SETUP_STATUS, 16, 55, 314, 14
  LTEXT "", IDC_SETUP_PROGRESS_DETAIL, 16, 75, 314, 23
  LTEXT "总进度 0%", IDC_SETUP_OVERALL, 16, 98, 314, 12, NOT WS_VISIBLE
  CONTROL "", IDC_SETUP_METER, "msctls_progress32", PBS_SMOOTH | NOT WS_VISIBLE, 16, 113, 314, 9
  CONTROL "", IDC_SETUP_PATH, "Static", SS_PATHELLIPSIS | SS_NOPREFIX, 16, 108, 314, 12
  AUTOCHECKBOX "立即打开 Kite(&L)", IDC_SETUP_LAUNCH, 125, 120, 209, 13, WS_TABSTOP
  PUSHBUTTON "< 上一步", IDC_SETUP_BACK, 171, 190, 52, 14, WS_DISABLED
  DEFPUSHBUTTON "继续", IDOK, 227, 190, 52, 14
  PUSHBUTTON "取消", IDCANCEL, 283, 190, 52, 14
END

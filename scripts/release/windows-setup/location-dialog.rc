#include <winres.h>
#include "resource.h"

IDD_SETUP DIALOGEX 0, 0, 386, 146
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | DS_CENTER | DS_SETFONT
EXSTYLE WS_EX_APPWINDOW
CAPTION "Kite 桌面版安装"
FONT 10, "Segoe UI"
BEGIN
  LTEXT "选择 Kite 桌面版的安装目录", IDC_SETUP_HEADING, 14, 14, 358, 14
  LTEXT "可直接编辑路径，也可浏览其他磁盘。", IDC_SETUP_DETAIL, 14, 32, 358, 12
  LTEXT "安装目录(&D)", -1, 14, 52, 279, 12
  EDITTEXT IDC_LOCATION, 14, 65, 279, 17, ES_AUTOHSCROLL | WS_TABSTOP
  PUSHBUTTON "浏览(&B)…", IDC_BROWSE, 301, 65, 71, 17
  AUTOCHECKBOX "创建桌面快捷方式(&S)", IDC_DESKTOP_SHORTCUT, 14, 94, 279, 15, WS_TABSTOP
  DEFPUSHBUTTON "安装(&I)", IDOK, 222, 118, 71, 18
  PUSHBUTTON "取消", IDCANCEL, 301, 118, 71, 18
END

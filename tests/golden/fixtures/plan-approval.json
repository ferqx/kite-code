  "initialEvents": [
    { "type": "tool.queued", "toolCallId": "call-1", "name": "write_plan", "args": {} }
  ],
  "effects": [
    {
      "events": [
        {
          "type": "plan.review_requested",
          "interactionId": "review-1",
          "toolCallId": "call-1",
          "plan": {
            "name": "Runtime guardrails",

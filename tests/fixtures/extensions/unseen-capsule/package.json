{
  "name": "@kite-test/unseen-capsule",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "peerDependencies": {
    "@kite-ai/agent": "0.1.0"
  },
  "scripts": {
    "build": "node --import ../../../../scripts/tooling/register.mjs ../../../../scripts/tooling/build-command.ts ./src/index.ts ./src/host.ts --target=node --packages=external --outdir=dist && node --import ../../../../scripts/tooling/register.mjs ../../../../scripts/tooling/build-command.ts ./src/worker.ts --target=node --outdir=dist/node",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}

{
  "name": "@kite-ai/kite-app-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web.ts",
    "./worker-controller": "./src/worker-controller.ts"

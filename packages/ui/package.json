{
  "name": "@kite-ai/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.tsx",
    "./tui": "./src/tui/index.tsx"
  },
  "scripts": {
    "build": "bun build ./src/index.tsx --target=browser --packages=external --outdir=dist && bun build ./src/tui/index.tsx --target=bun --packages=external --outdir=dist/tui",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test ./test"
  },
  "dependencies": {
    "@kite-ai/client": "workspace:*",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ink": "^7.1.1",
    "string-width": "^8.2.0",
    "unified": "11.0.5",
    "remark-parse": "11.0.0"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "react": "^19.2.6",
    "react-dom": "19.2.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "ink-testing-library": "^4.0.0"
  }
}

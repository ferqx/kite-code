{
  "name": "@kite-ai/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.tsx",
    "./tui": "./src/tui/index.tsx",
    "./desktop": "./src/desktop/index.ts",
    "./desktop/style.css": "./src/desktop/style.css"
  },
  "scripts": {
    "build": "bun build ./src/index.tsx --target=browser --packages=external --outdir=dist && bun build ./src/tui/index.tsx --target=bun --packages=external --outdir=dist/tui && bun run scripts/build-desktop.ts --outdir=dist/desktop",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test ./test"
  },
  "dependencies": {
    "@kite-ai/client": "workspace:*",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ink": "^7.1.1",
    "string-width": "^8.2.0",
    "unified": "11.0.5",
    "remark-parse": "11.0.0",
    "@hugeicons/core-free-icons": "4.3.2",
    "@hugeicons/react": "1.1.10",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "react-resizable-panels": "4.12.4",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "react": "^19.2.6",
    "react-dom": "19.2.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "ink-testing-library": "^4.0.0"
  }
}

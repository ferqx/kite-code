{
  "name": "@kite-ai/trace-extension-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bundle": "./src/bundle.ts"
  },
  "scripts": {
    "build": "node --import ../../scripts/tooling/register.mjs ../../scripts/tooling/build-command.ts ./src/index.ts --outdir ./dist --target browser --packages external && node --import ../../scripts/tooling/register.mjs ../../scripts/tooling/build-command.ts ./src/bundle.ts --outdir ./dist --target=node --packages external",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node --import ../../scripts/tooling/register.mjs ../../scripts/run-owned-tests.ts ."
  },
  "dependencies": {
    "@kite-ai/trajectory": "workspace:*"
  }
}

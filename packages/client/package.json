{
  "name": "@kite-ai/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./file-recovery-intent": "./src/file-recovery-intent.ts",
    "./sse": "./src/sse.ts"
  },
  "scripts": {
    "build": "node --import ../../scripts/tooling/register.mjs ../../scripts/tooling/build-command.ts ./src/index.ts ./src/sse.ts ./src/browser.ts ./src/file-recovery-intent.ts --target=browser --packages=external --outdir=dist",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node --import ../../scripts/tooling/register.mjs ../../scripts/run-test-files.ts ./test"
  },
  "dependencies": {
    "@kite-ai/trajectory": "workspace:*"
  }
}

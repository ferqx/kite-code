{
  "name": "@kite-ai/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sdk": "./src/sdk.ts"
  },
  "scripts": {
    "build": "bun --no-config --no-env-file --no-install ../../scripts/tooling/build-command.ts ./src/index.ts ./src/sdk.ts --outdir ./dist --target browser --splitting --packages bundle",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node --import ../../scripts/tooling/register.mjs ../../scripts/run-owned-tests.ts ."
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.19",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "ai": "^7.0.19"
  }
}

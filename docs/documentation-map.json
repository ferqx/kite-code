{
  "version": 2,
  "rules": [
    {
      "id": "unified-service",
      "sources": ["apps/service/src/**", "apps/service/package.json", "apps/service/generated/**"],
      "authorities": ["apps/service/README.md", "docs/active/unified-agent-boundary.md"]
    },
    {
      "id": "unified-desktop",
      "sources": [
        "apps/desktop/src/**",
        "apps/desktop/electron/**",
        "apps/desktop/scripts/**",
        "apps/desktop/package.json"
      ],
      "authorities": [
        "apps/desktop/README.md",
        "apps/desktop/docs/native-release.md",
        "docs/active/unified-agent-boundary.md"
      ]
    },
    {
      "id": "unified-cli",
      "sources": ["apps/cli/src/**", "apps/cli/host/**", "apps/cli/package.json"],
      "authorities": [
        "apps/cli/README.md",
        "apps/cli/docs/terminal-release.md",
        "docs/active/unified-agent-boundary.md"
      ]
    },
    {
      "id": "unified-client",
      "sources": ["packages/client/src/**", "packages/client/package.json"],
      "authorities": ["packages/client/README.md", "docs/active/unified-agent-boundary.md"]
    },
    {
      "id": "unified-ui",
      "sources": ["packages/ui/src/**", "packages/ui/package.json"],
      "authorities": ["packages/ui/README.md", "docs/active/unified-agent-boundary.md"]
    },
    {
      "id": "unified-web",
      "sources": ["apps/web/src/**", "apps/web/package.json"],
      "authorities": ["apps/web/README.md", "docs/active/unified-agent-boundary.md"]
    },
    {
      "id": "unified-agent",
      "sources": ["packages/agent/src/**", "packages/agent/package.json"],
      "authorities": ["packages/agent/README.md", "docs/active/unified-agent-boundary.md"]
    },
    {
      "id": "unified-ai",
      "sources": ["packages/ai/src/**", "packages/ai/package.json"],
      "authorities": ["packages/ai/README.md", "docs/active/unified-agent-boundary.md"]
    },
    {
      "id": "unified-agent-checks",
      "sources": [
        "scripts/check-unified-agent-boundary.ts",
        "scripts/check-unified-workspaces.ts",
        "scripts/generate-unified-api.ts",
        "scripts/run-unified-tests.ts"
      ],
      "authorities": ["tests/README.md", "docs/active/unified-agent-boundary.md"]
    },
    {
      "id": "documentation-governance",
      "sources": [
        "AGENTS.md",
        "docs/AGENTS.md",
        "docs/README.md",
        "docs/documentation-map.json",
        "scripts/check-docs.ts",
        "scripts/check-docs-impact.ts",
        ".agents/skills/document-before-commit/SKILL.md",
        "lefthook.yml",
        ".github/workflows/required.yml",
        "scripts/check-plan-execution-matrix.ts",
        ".github/pull_request_template.md",
        "CLAUDE.md"
      ],
      "authorities": ["docs/development/documentation.md", "docs/AGENTS.md"]
    },
    {
      "id": "root-package-manifest",
      "sources": ["package.json"],
      "authorities": [
        "tests/README.md",
        "docs/active/execution-platform-support.md",
        "docs/active/unified-agent-boundary.md",
        "docs/development/local-development.md"
      ]
    },
    {
      "id": "kite-cli",
      "sources": ["apps/kite-cli/src/**", "apps/kite-cli/package.json"],
      "excludeSources": [
        "apps/kite-cli/src/adapters/tui/**",
        "apps/kite-cli/src/tui/**",
        "apps/kite-cli/src/cli/executable.ts",
        "apps/kite-cli/src/cli/index.ts",
        "apps/kite-cli/src/runtime-client/tui-history-facade.ts",
        "apps/kite-cli/src/service-mode/**"
      ],
      "authorities": ["apps/kite-cli/README.md", "docs/active/six-concept-runtime-architecture.md"]
    },
    {
      "id": "kite-service-mode-adapter",
      "sources": ["apps/kite-cli/src/service-mode/**"],
      "authorities": [
        "apps/kite-cli/README.md",
        "apps/kite-cli/docs/service-mode.md",
        "docs/active/six-concept-runtime-architecture.md",
        "docs/active/runtime-resilience-qualification.md",
        "docs/handbook/server/data-and-access.md"
      ]
    },
    {
      "id": "kite-cli-command-runtime",
      "sources": ["apps/kite-cli/src/cli/executable.ts", "apps/kite-cli/src/cli/index.ts"],
      "authorities": [
        "apps/kite-cli/README.md",
        "apps/kite-cli/docs/service-mode.md",
        "apps/kite-cli/docs/input-and-commands.md",
        "docs/active/six-concept-runtime-architecture.md",
        "docs/active/runtime-authority-boundary.md",
        "docs/active/runtime-resilience-qualification.md",
        "docs/active/workspace-trust.md",
        "docs/active/execution-platform-support.md",
        "docs/active/app-server-local-runtime.md",
        "docs/handbook/cli/commands.md",
        "docs/handbook/cli/running-tasks.md"
      ]
    },
    {
      "id": "kite-runtime-history",
      "sources": ["apps/kite-cli/src/runtime-client/tui-history-facade.ts"],
      "authorities": [
        "apps/kite-cli/docs/input-and-commands.md",
        "docs/active/sqlite-runtime-log-query.md",
        "docs/active/runtime-authority-boundary.md",
        "docs/active/coordinator-workspace-worker-web.md",
        "docs/handbook/features/sessions.md",
        "apps/kite-cli/docs/session-navigation.md"
      ]
    },
    {
      "id": "tui-localization",
      "sources": ["apps/kite-cli/src/tui/i18n/**"],
      "authorities": [
        "apps/kite-cli/docs/tui-localization.md",
        "docs/handbook/clients/tui/reference/settings.md"
      ]
    },
    {
      "id": "tui-rendering",
      "sources": [
        "apps/kite-cli/src/tui/render/**",
        "apps/kite-cli/src/tui/components/**",
        "apps/kite-cli/src/tui/DiffPreview.tsx",
        "apps/kite-cli/src/tui/Footer.tsx",
        "apps/kite-cli/src/tui/Header.tsx",
        "apps/kite-cli/src/tui/OutputArea.tsx",
        "apps/kite-cli/src/tui/StatsLine.tsx",
        "apps/kite-cli/src/tui/StatusBar.tsx",
        "apps/kite-cli/src/tui/theme.ts",
        "apps/kite-cli/src/tui/reducers/**",
        "apps/kite-cli/src/tui/replay-blocks.ts",
        "apps/kite-cli/src/tui/runtime-presentation.ts",
        "apps/kite-cli/src/tui/types.ts"
      ],
      "authorities": [
        "apps/kite-cli/docs/terminal-output.md",
        "docs/handbook/clients/tui/interface.md"
      ],
      "excludeSources": [
        "apps/kite-cli/src/tui/components/CtrlSafeTextInput.tsx",
        "apps/kite-cli/src/tui/components/InputLine.tsx",
        "apps/kite-cli/src/tui/components/SlashSuggestionOverlay.tsx",
        "apps/kite-cli/src/tui/components/CheckpointSelector.tsx",
        "apps/kite-cli/src/tui/components/SessionSelector.tsx",
        "apps/kite-cli/src/tui/reducers/sessionReducer.ts",
        "apps/kite-cli/src/tui/components/ApprovalBlock.tsx",
        "apps/kite-cli/src/tui/components/InputBlock.tsx",
        "apps/kite-cli/src/tui/components/PlanReviewBlock.tsx",
        "apps/kite-cli/src/tui/Footer.tsx",
        "apps/kite-cli/src/tui/Header.tsx",
        "apps/kite-cli/src/tui/OutputArea.tsx",
        "apps/kite-cli/src/tui/StatsLine.tsx",
        "apps/kite-cli/src/tui/StatusBar.tsx",
        "apps/kite-cli/src/tui/theme.ts",
        "apps/kite-cli/src/tui/reducers/actions.ts",
        "apps/kite-cli/src/tui/reducers/agentReducer.ts",
        "apps/kite-cli/src/tui/reducers/cancellation-projection.ts",
        "apps/kite-cli/src/tui/reducers/checkpointReducer.ts",
        "apps/kite-cli/src/tui/reducers/consolidateTools.ts",
        "apps/kite-cli/src/tui/reducers/handleClientEvent.ts",
        "apps/kite-cli/src/tui/reducers/helpers.ts",
        "apps/kite-cli/src/tui/reducers/index.ts",
        "apps/kite-cli/src/tui/reducers/skillReducer.ts",
        "apps/kite-cli/src/tui/reducers/tool-summary-result.ts",
        "apps/kite-cli/src/tui/reducers/uiReducer.ts",
        "apps/kite-cli/src/tui/replay-blocks.ts",
        "apps/kite-cli/src/tui/runtime-presentation.ts",
        "apps/kite-cli/src/tui/types.ts",
        "apps/kite-cli/src/tui/render/**"
      ]
    },
    {
      "id": "tui-interaction",
      "sources": ["apps/kite-cli/src/tui/**", "apps/kite-cli/src/adapters/tui/**"],
      "excludeSources": [
        "apps/kite-cli/src/tui/i18n/**",
        "apps/kite-cli/src/tui/render/**",
        "apps/kite-cli/src/tui/components/**",
        "apps/kite-cli/src/tui/DiffPreview.tsx",
        "apps/kite-cli/src/tui/Footer.tsx",
        "apps/kite-cli/src/tui/Header.tsx",
        "apps/kite-cli/src/tui/OutputArea.tsx",
        "apps/kite-cli/src/tui/StatsLine.tsx",
        "apps/kite-cli/src/tui/StatusBar.tsx",
        "apps/kite-cli/src/tui/theme.ts",
        "apps/kite-cli/src/tui/reducers/**",
        "apps/kite-cli/src/tui/replay-blocks.ts",
        "apps/kite-cli/src/tui/runtime-presentation.ts",
        "apps/kite-cli/src/tui/types.ts",
        "apps/kite-cli/src/tui/hooks/useFileSearch.ts",
        "apps/kite-cli/src/tui/hooks/useGlobalKeys.ts",
        "apps/kite-cli/src/tui/hooks/useSlashCommand.ts",
        "apps/kite-cli/src/tui/hooks/useSlashSuggestions.ts",
        "apps/kite-cli/src/tui/prompt-submission-queue.ts",
        "apps/kite-cli/src/tui/hooks/useRewindHandler.ts",
        "apps/kite-cli/src/tui/hooks/useSessionList.ts",
        "apps/kite-cli/src/tui/session-navigation.ts",
        "apps/kite-cli/src/tui/session-open-diagnostic.ts",
        "apps/kite-cli/src/tui/interaction-submission-diagnostic.ts",
        "apps/kite-cli/src/tui/hooks/terminal-focus-store.ts",
        "apps/kite-cli/src/tui/hooks/useTerminalFocus.ts",
        "apps/kite-cli/src/tui/hooks/useWindowSizeSig.ts",
        "apps/kite-cli/src/tui/presentation/**"
      ],
      "authorities": [
        "apps/kite-cli/docs/runtime-application.md",
        "apps/kite-cli/docs/input-and-commands.md",
        "docs/handbook/clients/tui/interface.md"
      ]
    },
    {
      "id": "runtime-workspace-boundaries",
      "sources": ["bun.lock", "tsconfig.json", "scripts/run-runtime-workspace-script.ts"],
      "authorities": ["docs/active/unified-agent-boundary.md", "tests/README.md"]
    },
    {
      "id": "test-system",
      "sources": [
        "scripts/run-default-tests.ts",
        "scripts/unified-test-plan.ts",
        "scripts/run-owned-tests.ts",
        "scripts/test-suite.ts",
        "scripts/check-test-ownership.ts",
        "lefthook.yml",
        ".github/workflows/required.yml",
        "tests/integration/scripts/check-test-ownership.test.ts",
        "tests/integration/scripts/test-discovery.test.ts",
        "tests/isolated/scripts/test-suite-runner.test.ts"
      ],
      "authorities": ["tests/README.md"]
    },
    {
      "id": "tui-system-tests",
      "sources": ["scripts/run-tui-system-tests.ts", "tests/tui-system/harness/**"],
      "authorities": ["apps/kite-cli/docs/tui-system-testing.md", "tests/README.md"]
    },
    {
      "id": "runtime-resilience",
      "sources": [
        "scripts/runtime/**",
        "tests/qualification/runtime/**",
        ".github/workflows/runtime-resilience-qualification.yml"
      ],
      "authorities": ["docs/active/runtime-resilience-qualification.md", "tests/README.md"]
    },
    {
      "id": "runtime-transport-qualification",
      "sources": [
        ".github/workflows/runtime-stdio-smoke.yml",
        ".github/workflows/runtime-transport-qualification.yml"
      ],
      "authorities": [
        "docs/active/runtime-resilience-qualification.md",
        "docs/active/execution-platform-support.md",
        "tests/README.md"
      ]
    },
    {
      "id": "release-candidate",
      "sources": [
        "release/**",
        "scripts/release/**",
        "scripts/ci/**",
        "tests/release/**",
        ".agents/notes/implemented/process/2026-08-04-first-release-terminal-scope.md",
        ".github/workflows/release-candidate.yml"
      ],
      "excludeSources": ["scripts/release/build-windows-runner.ts"],
      "authorities": [
        "docs/active/release-control.md",
        "docs/active/open-source-first-release.md",
        "docs/active/app-server-local-runtime.md"
      ]
    },
    {
      "id": "platform-qualification",
      "sources": [
        ".github/workflows/platform-capability-probe.yml",
        ".github/workflows/execution-boundary-conformance.yml",
        "native/windows-sandbox-runner/**",
        "scripts/release/build-windows-runner.ts"
      ],
      "authorities": [
        "docs/active/execution-platform-support.md",
        "docs/active/execution-boundary.md",
        "docs/active/windows-shell-sandbox.md"
      ]
    },
    {
      "id": "mcp-control-plane",
      "sources": [
        ".github/workflows/mcp-native-keyring-smoke.yml",
        ".github/workflows/mcp-langchain-live-smoke.yml"
      ],
      "authorities": [
        "docs/active/mcp-control-plane.md",
        "docs/active/mcp-authentication.md",
        "docs/active/mcp-project-approval.md",
        "docs/handbook/clients/tui/guides/mcp-and-skills.md"
      ]
    },
    {
      "id": "observability-and-session-logging",
      "sources": [".github/workflows/session-log-acl-smoke.yml", "scripts/operations/**"],
      "authorities": [
        "docs/active/observability-privacy-operations.md",
        "docs/active/session-logging-policy.md"
      ]
    },
    {
      "id": "tui-input",
      "sources": [

{
  "version": 1,
  "rules": [
    {
      "id": "runtime-kernel",
      "sources": ["src/core/runtime/**"],
      "documents": [
        "docs/active/six-concept-runtime-architecture.md",
        "docs/book/04-Agent引擎.md",
        "docs/book/10-持久化与会话管理.md"
      ]
    },
    {
      "id": "capabilities",
      "sources": ["src/core/capabilities/**", "src/protocol/capabilities.ts"],
      "documents": [
        "docs/active/capability-progressive-disclosure.md",
        "docs/active/six-concept-runtime-architecture.md"
      ]
    },
    {
      "id": "mcp-and-skills",
      "sources": ["src/core/mcp/**", "src/core/skills/**"],
      "documents": ["docs/active/mcp-runtime-governance.md", "docs/book/11-MCP与Skills扩展.md"]
    },
    {
      "id": "mcp-control-plane",
      "sources": [
        "src/core/config/mcp-config.ts",
        "src/core/config/mcp-config-repository.ts",
        "src/core/config/mcp-project-approvals.ts",
        "src/core/config/mcp-server-config.ts",
        "src/core/config/paths.ts",
        "src/core/mcp/control-types.ts",
        "src/core/mcp/diagnostics.ts",
        "src/core/mcp/manager.ts",
        "src/core/mcp/runtime-provider.ts",
        "src/core/mcp/supervisor.ts",
        "src/app/tui/App.tsx",
        "src/app/tui/index.tsx",
        "src/app/tui/hooks/useMcpController.ts",
        "src/app/tui/hooks/useSlashCommand.ts",
        "src/app/tui/run-agent.ts",
        "src/app/tui/session-manager.ts",
        "src/app/tui/mcp/**"
      ],
      "documents": [
        "docs/active/mcp-control-plane.md",
        "docs/active/mcp-config-management.md",
        "docs/active/mcp-project-approval.md",
        "docs/active/mcp-runtime-governance.md",
        "docs/book/08-TUI交互全景.md",
        "docs/book/09-CLI模式与配置.md",
        "docs/book/11-MCP与Skills扩展.md",
        "README.md"
      ]
    },
    {
      "id": "verification",
      "sources": ["src/core/verification/**", "src/protocol/verification.ts"],
      "documents": [
        "docs/active/verification-governance.md",
        "docs/active/six-concept-runtime-architecture.md"
      ]
    },
    {
      "id": "policy-and-execution",
      "sources": [
        "src/core/policies/**",
        "src/core/sandbox/**",
        "src/core/controllers/tool-controller.ts",
        "src/core/execution/**",
        "src/core/harness/tool-policy.ts",
        "src/core/harness/tool-runner.ts"
      ],
      "documents": [
        "docs/active/tool-gated-autonomy.md",
        "docs/active/authorization.md",
        "docs/book/05-工具系统与安全策略.md"
      ]
    },
    {
      "id": "model-and-context",
      "sources": ["src/core/model/**", "src/core/prompts/**"],
      "documents": [
        "docs/active/model-provider-boundary.md",
        "docs/active/plan-state-reminder.md",
        "docs/book/04-Agent引擎.md"
      ]
    },
    {
      "id": "subagent",
      "sources": ["src/core/subagent/**", "src/protocol/subagent.ts"],
      "documents": ["docs/active/cancel-resume-cleanup.md", "docs/book/06-多Agent协作.md"]
    },
    {
      "id": "builtin-tools",
      "sources": ["src/core/tools/**"],
      "documents": [
        "docs/active/tool-description-contracts.md",
        "docs/active/tool-gated-autonomy.md",
        "docs/book/05-工具系统与安全策略.md"
      ]
    },
    {
      "id": "tui",
      "sources": ["src/app/tui/**"],
      "documents": ["docs/book/07-TUI结构.md", "docs/book/08-TUI交互全景.md"]
    },
    {
      "id": "cli-and-config",
      "sources": ["src/app/cli/**", "src/core/config/**"],
      "documents": ["README.md", "docs/book/09-CLI模式与配置.md"]
    },
    {
      "id": "protocol",
      "sources": ["src/protocol/**"],
      "documents": ["docs/book/03-协议层.md"]
    }
  ]
}

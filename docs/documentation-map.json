{
  "version": 2,
  "rules": [
    {
      "id": "documentation-governance",
      "sources": [
        "AGENTS.md",
        "docs/AGENTS.md",
        "docs/README.md",
        "docs/documentation-map.json",
        "scripts/check-docs.ts",
        "scripts/check-docs-impact.ts",
        ".agents/skills/document-before-commit/SKILL.md",
        "lefthook.yml",
        ".github/workflows/required.yml"
      ],
      "authorities": ["docs/README.md", "docs/active/documentation-language.md"]
    },
    {
      "id": "root-package-manifest",
      "sources": ["package.json"],
      "authorities": [
        "docs/README.md",
        "tests/README.md",
        "docs/active/execution-platform-support.md",
        "docs/active/six-concept-runtime-architecture.md"
      ]
    },
    {
      "id": "runtime-contract",
      "sources": ["packages/runtime-contract/src/**", "packages/runtime-contract/package.json"],
      "authorities": [
        "packages/runtime-contract/README.md",
        "docs/active/six-concept-runtime-architecture.md"
      ]
    },
    {
      "id": "runtime-protocol",
      "sources": ["packages/runtime-protocol/src/**", "packages/runtime-protocol/package.json"],
      "authorities": [
        "packages/runtime-protocol/README.md",
        "docs/active/six-concept-runtime-architecture.md"
      ]
    },
    {
      "id": "runtime-server",
      "sources": ["packages/runtime-server/src/**", "packages/runtime-server/package.json"],
      "authorities": [
        "packages/runtime-server/README.md",
        "docs/active/six-concept-runtime-architecture.md",
        "docs/active/runtime-authority-boundary.md"
      ]
    },
    {
      "id": "runtime-client",
      "sources": ["packages/runtime-client/src/**", "packages/runtime-client/package.json"],
      "authorities": [
        "packages/runtime-client/README.md",
        "docs/active/six-concept-runtime-architecture.md",
        "docs/active/runtime-resilience-qualification.md"
      ]
    },
    {
      "id": "agent-kernel",
      "sources": ["packages/agent-kernel/src/**", "packages/agent-kernel/package.json"],
      "excludeSources": [
        "packages/agent-kernel/src/core/authorization/**",
        "packages/agent-kernel/src/tool-governance.ts"
      ],
      "authorities": [
        "packages/agent-kernel/README.md",
        "docs/active/six-concept-runtime-architecture.md"
      ]
    },
    {
      "id": "agent-kernel-authorization",
      "sources": [
        "packages/agent-kernel/src/core/authorization/**",
        "packages/agent-kernel/src/tool-governance.ts"
      ],
      "authorities": ["docs/active/authorization.md"]
    },
    {
      "id": "runtime-spi",
      "sources": ["packages/runtime-spi/src/**", "packages/runtime-spi/package.json"],
      "authorities": [
        "packages/runtime-spi/README.md",
        "docs/active/six-concept-runtime-architecture.md"
      ]
    },
    {
      "id": "runtime-host",
      "sources": ["packages/runtime-host/src/**", "packages/runtime-host/package.json"],
      "excludeSources": [
        "packages/runtime-host/src/process/**",
        "packages/runtime-host/src/host/command-receipt.ts",
        "packages/runtime-host/src/host/runtime-host.ts",
        "packages/runtime-host/src/storage/index.ts"
      ],
      "authorities": [
        "packages/runtime-host/README.md",
        "docs/active/runtime-authority-boundary.md"
      ]
    },
    {
      "id": "runtime-host-command-receipts",
      "sources": [
        "packages/runtime-host/src/host/command-receipt.ts",
        "packages/runtime-host/src/host/runtime-host.ts",
        "packages/runtime-host/src/storage/index.ts"
      ],
      "authorities": [
        "packages/runtime-host/README.md",
        "docs/active/runtime-authority-boundary.md",
        "docs/active/runtime-resilience-qualification.md"
      ]
    },
    {
      "id": "runtime-storage-sqlite",
      "sources": [
        "packages/runtime-storage-sqlite/src/**",
        "packages/runtime-storage-sqlite/package.json"
      ],
      "authorities": [
        "packages/runtime-storage-sqlite/README.md",
        "docs/active/runtime-authority-boundary.md",
        "docs/active/sqlite-runtime-log-query.md",
        "docs/active/runtime-resilience-qualification.md"
      ]
    },
    {
      "id": "builtin-runtime",
      "sources": ["packages/builtin-runtime/src/**", "packages/builtin-runtime/package.json"],
      "excludeSources": [
        "packages/builtin-runtime/src/model/**",
        "packages/builtin-runtime/src/model-context.ts",
        "packages/builtin-runtime/src/mcp/**",
        "packages/builtin-runtime/src/sandbox/**"
      ],
      "authorities": ["packages/builtin-runtime/README.md", "docs/active/tool-gated-autonomy.md"]
    },
    {
      "id": "builtin-model",
      "sources": [
        "packages/builtin-runtime/src/model/**",
        "packages/builtin-runtime/src/model-context.ts"
      ],
      "authorities": ["docs/active/model-provider-boundary.md"]
    },
    {
      "id": "builtin-mcp",
      "sources": ["packages/builtin-runtime/src/mcp/**"],
      "authorities": ["docs/active/mcp-runtime-governance.md"]
    },
    {
      "id": "kite-cli",
      "sources": ["apps/kite-cli/src/**", "apps/kite-cli/package.json"],
      "excludeSources": [
        "apps/kite-cli/src/adapters/tui/**",
        "apps/kite-cli/src/tui/**",
        "apps/kite-cli/src/observability/**",
        "apps/kite-cli/src/session-logger/**",
        "apps/kite-cli/src/config/session-logging-policy.ts",
        "apps/kite-cli/src/config/mcp-config.ts",
        "apps/kite-cli/src/config/mcp-config-repository.ts",
        "apps/kite-cli/src/config/mcp-project-approvals.ts",
        "apps/kite-cli/src/config/mcp-server-config.ts",
        "apps/kite-cli/src/bootstrap.ts",
        "apps/kite-cli/src/carrier/**",
        "apps/kite-cli/src/cli/executable.ts",
        "apps/kite-cli/src/cli/index.ts",
        "apps/kite-cli/src/logs/runtime-log-presentation.ts",
        "apps/kite-cli/src/runtime-client/history-adapter.ts",
        "apps/kite-cli/src/runtime-client/presentation-history.ts",
        "apps/kite-cli/src/runtime-client/tui-history-facade.ts",
        "apps/kite-cli/src/sandbox/**",
        "apps/kite-cli/src/release/**"
      ],
      "authorities": ["apps/kite-cli/README.md", "docs/active/six-concept-runtime-architecture.md"]
    },
    {
      "id": "kite-runtime-carriers",
      "sources": [
        "apps/kite-cli/src/bootstrap.ts",
        "apps/kite-cli/src/carrier/**",
        "apps/kite-cli/src/cli/executable.ts",
        "apps/kite-cli/src/cli/index.ts"
      ],
      "authorities": [
        "apps/kite-cli/README.md",
        "apps/kite-cli/docs/runtime-server-carrier.md",
        "docs/active/six-concept-runtime-architecture.md",
        "docs/active/runtime-authority-boundary.md",
        "docs/active/runtime-resilience-qualification.md",
        "docs/active/workspace-trust.md",
        "docs/active/execution-platform-support.md"
      ]
    },
    {
      "id": "kite-runtime-history",
      "sources": [
        "apps/kite-cli/src/logs/runtime-log-presentation.ts",
        "apps/kite-cli/src/runtime-client/history-adapter.ts",
        "apps/kite-cli/src/runtime-client/presentation-history.ts",
        "apps/kite-cli/src/runtime-client/tui-history-facade.ts"
      ],
      "authorities": [
        "apps/kite-cli/README.md",
        "apps/kite-cli/docs/tui-interaction.md",
        "docs/active/sqlite-runtime-log-query.md",
        "docs/active/runtime-authority-boundary.md"
      ]
    },
    {
      "id": "tui-localization",
      "sources": ["apps/kite-cli/src/tui/i18n/**"],
      "authorities": ["apps/kite-cli/docs/tui-localization.md"]
    },
    {
      "id": "tui-rendering",
      "sources": [
        "apps/kite-cli/src/tui/render/**",
        "apps/kite-cli/src/tui/components/**",
        "apps/kite-cli/src/tui/DiffPreview.tsx",
        "apps/kite-cli/src/tui/Footer.tsx",
        "apps/kite-cli/src/tui/Header.tsx",
        "apps/kite-cli/src/tui/OutputArea.tsx",
        "apps/kite-cli/src/tui/StatsLine.tsx",
        "apps/kite-cli/src/tui/StatusBar.tsx",
        "apps/kite-cli/src/tui/theme.ts",
        "apps/kite-cli/src/tui/reducers/**",
        "apps/kite-cli/src/tui/replay-blocks.ts",
        "apps/kite-cli/src/tui/runtime-presentation.ts",
        "apps/kite-cli/src/tui/types.ts"
      ],
      "authorities": ["apps/kite-cli/docs/tui-rendering.md"]
    },
    {
      "id": "tui-interaction",
      "sources": ["apps/kite-cli/src/tui/**", "apps/kite-cli/src/adapters/tui/**"],
      "excludeSources": [
        "apps/kite-cli/src/tui/i18n/**",
        "apps/kite-cli/src/tui/render/**",
        "apps/kite-cli/src/tui/components/**",
        "apps/kite-cli/src/tui/DiffPreview.tsx",
        "apps/kite-cli/src/tui/Footer.tsx",
        "apps/kite-cli/src/tui/Header.tsx",
        "apps/kite-cli/src/tui/OutputArea.tsx",
        "apps/kite-cli/src/tui/StatsLine.tsx",
        "apps/kite-cli/src/tui/StatusBar.tsx",
        "apps/kite-cli/src/tui/theme.ts",
        "apps/kite-cli/src/tui/reducers/**",
        "apps/kite-cli/src/tui/replay-blocks.ts",
        "apps/kite-cli/src/tui/runtime-presentation.ts",
        "apps/kite-cli/src/tui/types.ts"
      ],
      "authorities": ["apps/kite-cli/docs/tui-interaction.md"]
    },
    {
      "id": "runtime-workspace-boundaries",
      "sources": [
        "bun.lock",
        "tsconfig.json",
        "scripts/check-core-boundary.ts",
        "scripts/check-pre-release-architecture.ts",
        "scripts/check-runtime-packages.ts",
        "scripts/runtime-packages/**",
        "scripts/run-runtime-workspace-script.ts"
      ],
      "authorities": ["docs/active/six-concept-runtime-architecture.md"]
    },
    {
      "id": "test-system",
      "sources": [
        "scripts/run-default-tests.ts",
        "scripts/run-owned-tests.ts",
        "scripts/test-suite.ts",
        "scripts/check-test-ownership.ts",
        "lefthook.yml",
        ".github/workflows/required.yml",
        "tests/integration/scripts/check-test-ownership.test.ts",
        "tests/integration/scripts/ci-bun-baseline.test.ts",
        "tests/integration/scripts/test-discovery.test.ts",
        "tests/isolated/scripts/test-suite-runner.test.ts"
      ],
      "authorities": ["tests/README.md"]
    },
    {
      "id": "tui-system-tests",
      "sources": ["scripts/run-tui-system-tests.ts", "tests/tui-system/harness/**"],
      "authorities": ["apps/kite-cli/docs/tui-system-testing.md", "tests/README.md"]
    },
    {
      "id": "runtime-resilience",
      "sources": [
        "scripts/runtime/**",
        "tests/qualification/runtime/**",
        ".github/workflows/runtime-resilience-qualification.yml"
      ],
      "authorities": ["docs/active/runtime-resilience-qualification.md", "tests/README.md"]
    },
    {
      "id": "runtime-transport-qualification",
      "sources": [
        ".github/workflows/runtime-stdio-smoke.yml",
        ".github/workflows/runtime-transport-qualification.yml",
        "apps/kite-cli/test/isolated/bun-stdio-child-transport.test.ts",
        "apps/kite-cli/test/isolated/bun-websocket-transport.test.ts",
        "apps/kite-cli/test/isolated/development-loopback-carrier.test.ts",
        "apps/kite-cli/test/isolated/development-runtime-reference.test.ts",
        "apps/kite-cli/test/isolated/development-websocket-runtime-client.test.ts",
        "apps/kite-cli/test/isolated/runtime-stdio-carrier.test.ts",
        "apps/kite-cli/test/isolated/runtime-stdio-child.test.ts",
        "apps/kite-cli/test/isolated/runtime-transport-conformance.test.ts"
      ],
      "authorities": [
        "apps/kite-cli/docs/runtime-server-carrier.md",
        "docs/active/runtime-resilience-qualification.md",
        "docs/active/execution-platform-support.md",
        "tests/README.md"
      ]
    },
    {
      "id": "release-candidate",
      "sources": [
        "release/**",
        "apps/kite-cli/src/release/**",
        "scripts/release/**",
        "tests/release/**",
        "docs/adr/0069-first-release-terminal-scope.md",
        ".github/workflows/release-candidate.yml"
      ],
      "excludeSources": [
        "scripts/release/build-windows-runner.ts",
        "scripts/release/execution-boundary-smoke.ts",
        "scripts/release/platform-capability-probe.ts",
        "scripts/release/platform-smoke.ts",
        "scripts/release/session-log-acl-smoke.ts",
        "scripts/release/verify-platform-capability-evidence.ts",
        "scripts/release/windows-runner-evidence.ts"
      ],
      "authorities": ["docs/active/release-control.md", "docs/active/open-source-first-release.md"]
    },
    {
      "id": "platform-qualification",
      "sources": [
        "scripts/release/build-windows-runner.ts",
        "scripts/release/execution-boundary-smoke.ts",
        "scripts/release/platform-capability-probe.ts",
        "scripts/release/platform-smoke.ts",
        "scripts/release/verify-platform-capability-evidence.ts",
        "scripts/release/windows-runner-evidence.ts",
        "tests/qualification/sandbox/**",
        ".github/workflows/platform-capability-probe.yml",
        ".github/workflows/execution-boundary-conformance.yml"
      ],
      "authorities": [
        "docs/active/execution-platform-support.md",
        "docs/active/execution-boundary.md"
      ]
    },
    {
      "id": "mcp-control-plane",
      "sources": [
        "apps/kite-cli/src/config/mcp-config.ts",
        "apps/kite-cli/src/config/mcp-config-repository.ts",
        "apps/kite-cli/src/config/mcp-project-approvals.ts",
        "apps/kite-cli/src/config/mcp-server-config.ts",
        ".github/workflows/mcp-native-keyring-smoke.yml",
        ".github/workflows/mcp-langchain-live-smoke.yml"
      ],
      "authorities": [
        "docs/active/mcp-control-plane.md",
        "docs/active/mcp-authentication.md",
        "docs/active/mcp-project-approval.md"
      ]
    },
    {
      "id": "execution-governance",
      "sources": [
        "packages/builtin-runtime/src/sandbox/**",
        "packages/runtime-host/src/process/**",
        "apps/kite-cli/src/sandbox/**"
      ],
      "authorities": [
        "docs/active/execution-boundary.md",
        "docs/active/runtime-authority-boundary.md"
      ]
    },
    {
      "id": "observability-and-session-logging",
      "sources": [
        "apps/kite-cli/src/observability/**",
        "apps/kite-cli/src/session-logger/**",
        "apps/kite-cli/src/config/session-logging-policy.ts",
        "scripts/release/session-log-acl-smoke.ts",
        ".github/workflows/session-log-acl-smoke.yml"
      ],
      "authorities": [
        "docs/active/observability-privacy-operations.md",
        "docs/active/session-logging-policy.md"
      ]
    }
  ]
}

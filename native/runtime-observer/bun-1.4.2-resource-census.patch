@@ -0,0 +1,349 @@
+//! Primitive lifecycle evidence, not a complete runtime census yet.
+//! No JS values, resource ownership, I/O or callbacks are retained by this module.
+use std::collections::HashMap;
+use std::sync::{LazyLock, Mutex};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Hash)]
+pub enum Kind {
+    PoolJob,
+    FilePoll,
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum State {
+    Allocated,
+    Queued,
+    Running,
+    CompletionQueued,
+    Watching,
+    Dormant,
+    Closing,
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct Status {
+    pub state: State,
+    pub ref_active: bool,
+    pub pending: bool,
+    pub closing: bool,
+}
+impl Status {
+    pub const fn job(state: State) -> Self {
+        Self {
+            state,
+            ref_active: true,
+            pending: true,
+            closing: false,
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct Entry {
+    pub resource_id: u64,
+    pub kind: Kind,
+    pub status: Status,
+}
+#[derive(Debug)]
+pub struct Snapshot {
+    pub generation: u64,
+    pub observation_valid: bool,
+    /// Always false until all enabled primitive families are connected.
+    pub coverage_complete: bool,
+    pub uncovered: &'static [&'static str],
+    pub entries: Vec<Entry>,
+    pub live: usize,
+    pub ref_active: usize,
+    pub pending: usize,
+    pub closing: usize,
+}
+struct Registry {
+    entries: HashMap<(Kind, usize), Entry>,
+    next_id: u64,
+    generation: u64,
+    valid: bool,
+}
+impl Registry {
+    fn new() -> Self {
+        Self {
+            entries: HashMap::new(),
+            next_id: 1,
+            generation: 0,
+            valid: true,
+        }
+    }
+    fn changed(&mut self) {
+        match self.generation.checked_add(1) {
+            Some(value) => self.generation = value,
+            None => self.valid = false,
+        }
+    }
+    fn register(&mut self, kind: Kind, address: usize, status: Status) {
+        if address == 0 || self.entries.contains_key(&(kind, address)) {
+            self.valid = false;
+            return;
+        }
+        let Some(next_id) = self.next_id.checked_add(1) else {
+            self.valid = false;
+            return;
+        };
+        if self.entries.try_reserve(1).is_err() {
+            self.valid = false;
+            return;
+        }
+        self.entries.insert(
+            (kind, address),
+            Entry {
+                resource_id: self.next_id,
+                kind,
+                status,
+            },
+        );
+        self.next_id = next_id;
+        self.changed();
+    }
+    fn update(&mut self, kind: Kind, address: usize, mut status: Status) {
+        let Some(entry) = self.entries.get_mut(&(kind, address)) else {
+            self.valid = false;
+            return;
+        };
+        // Closing is terminal for this native identity. Ref/poll flags may
+        // still change during cleanup, but recycling alone ends its lifetime.
+        if entry.status.closing {
+            status.state = State::Closing;
+            status.closing = true;
+        }
+        if entry.status != status {
+            entry.status = status;
+            self.changed();
+        }
+    }
+    fn release(&mut self, kind: Kind, address: usize) {
+        if self.entries.remove(&(kind, address)).is_none() {
+            self.valid = false;
+        } else {
+            self.changed();
+        }
+    }
+    fn invalidate(&mut self) {
+        self.valid = false;
+        self.changed();
+    }
+    fn snapshot(&mut self) -> Option<Snapshot> {
+        let mut entries = Vec::new();
+        if entries.try_reserve_exact(self.entries.len()).is_err() {
+            self.valid = false;
+            return None;
+        }
+        entries.extend(self.entries.values().copied());
+        entries.sort_unstable_by_key(|entry| entry.resource_id);
+        Some(Snapshot {
+            generation: self.generation,
+            observation_valid: self.valid,
+            coverage_complete: false,
+            uncovered: &[
+                "timers",
+                "sockets-including-http-background-loop",
+                "workers",
+                "non-Job-requests-and-native-addons",
+                "windows-file-polls",
+            ],
+            live: entries.len(),
+            ref_active: entries
+                .iter()
+                .filter(|entry| entry.status.ref_active)
+                .count(),
+            pending: entries.iter().filter(|entry| entry.status.pending).count(),
+            closing: entries.iter().filter(|entry| entry.status.closing).count(),
+            entries,
+        })
+    }
+}
+static REGISTRY: LazyLock<Mutex<Registry>> = LazyLock::new(|| Mutex::new(Registry::new()));
+fn with_registry<T>(body: impl FnOnce(&mut Registry) -> T) -> T {
+    let mut registry = match REGISTRY.lock() {
+        Ok(registry) => registry,
+        Err(poisoned) => {
+            let mut registry = poisoned.into_inner();
+            registry.valid = false;
+            registry
+        }
+    };
+    body(&mut registry)
+}
+/// Address is only an internal lookup key; snapshots expose monotonic IDs.
+pub fn register(kind: Kind, address: usize, status: Status) {
+    with_registry(|registry| registry.register(kind, address, status));
+}
+pub fn update(kind: Kind, address: usize, status: Status) {
+    with_registry(|registry| registry.update(kind, address, status));
+}
+pub fn release(kind: Kind, address: usize) {
+    with_registry(|registry| registry.release(kind, address));
+}
+/// A real native transition failed: counts cannot establish kernel closure.
+/// Sticky for the process lifetime, even if the owner's storage is recycled.
+pub fn invalidate() {
+    with_registry(Registry::invalidate);
+}
+/// All primitive hook updates and this copy share one process-wide lock.
+/// None means observation allocation failed, never an empty successful census.
+pub fn snapshot() -> Option<Snapshot> {
+    with_registry(Registry::snapshot)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn lifecycle_identity_and_partial_coverage() {
+        let mut registry = Registry::new();
+        registry.register(Kind::PoolJob, 1, Status::job(State::Queued));
+        let first = registry.snapshot().unwrap();
+        assert!(first.observation_valid);
+        assert!(!first.coverage_complete);
+        assert_eq!((first.live, first.ref_active, first.pending), (1, 1, 1));
+        registry.update(Kind::PoolJob, 1, Status::job(State::CompletionQueued));
+        registry.release(Kind::PoolJob, 1);
+        registry.register(Kind::PoolJob, 1, Status::job(State::Queued));
+        let second = registry.snapshot().unwrap();
+        assert!(second.entries[0].resource_id > first.entries[0].resource_id);
+        assert!(second.generation > first.generation);
+    }
+    #[test]
+    fn failures_are_sticky_and_do_not_replace_entries() {
+        let mut registry = Registry::new();
+        registry.register(Kind::FilePoll, 1, Status::job(State::Queued));
+        registry.register(Kind::FilePoll, 1, Status::job(State::Running));
+        assert_eq!(registry.entries.len(), 1);
+        assert_eq!(
+            registry.entries[&(Kind::FilePoll, 1)].status.state,
+            State::Queued
+        );
+        registry.update(Kind::FilePoll, 2, Status::job(State::Running));
+        registry.release(Kind::FilePoll, 2);
+        assert!(!registry.snapshot().unwrap().observation_valid);
+    }
+    #[test]
+    fn closing_storage_stays_live_until_recycled_and_error_stays_unknown() {
+        let mut registry = Registry::new();
+        registry.register(
+            Kind::FilePoll,
+            1,
+            Status {
+                state: State::Watching,
+                ref_active: true,
+                pending: true,
+                closing: false,
+            },
+        );
+        registry.update(
+            Kind::FilePoll,
+            1,
+            Status {
+                state: State::Closing,
+                ref_active: false,
+                pending: false,
+                closing: true,
+            },
+        );
+        registry.update(
+            Kind::FilePoll,
+            1,
+            Status {
+                state: State::Dormant,
+                ref_active: false,
+                pending: false,
+                closing: false,
+            },
+        );
+        let closing = registry.snapshot().unwrap();
+        assert_eq!((closing.live, closing.closing), (1, 1));
+        registry.invalidate();
+        registry.release(Kind::FilePoll, 1);
+        let recycled = registry.snapshot().unwrap();
+        assert_eq!(recycled.live, 0);
+        assert!(!recycled.observation_valid);
+        assert!(!recycled.coverage_complete);
+        registry.register(Kind::FilePoll, 1, Status::job(State::Queued));
+        assert!(!registry.snapshot().unwrap().observation_valid);
+    }
+    #[test]
+    fn concurrent_snapshot_is_one_locked_generation() {
+        use std::sync::Arc;
+        let registry = Arc::new(Mutex::new(Registry::new()));
+        let threads: Vec<_> = (0..4)
+            .map(|thread| {
+                let registry = Arc::clone(&registry);
+                std::thread::spawn(move || {
+                    for item in 0..256 {
+                        let address = 1 + thread * 256 + item;
+                        registry.lock().unwrap().register(
+                            Kind::PoolJob,
+                            address,
+                            Status::job(State::Queued),
+                        );
+                        registry.lock().unwrap().update(
+                            Kind::PoolJob,
+                            address,
+                            Status::job(State::Running),
+                        );
+                        registry.lock().unwrap().release(Kind::PoolJob, address);
+                    }
+                })
+            })
+            .collect();
+        for _ in 0..64 {
+            let snapshot = registry.lock().unwrap().snapshot().unwrap();
+            assert!(snapshot.observation_valid);
+            assert!(!snapshot.coverage_complete);
+            assert_eq!(snapshot.live, snapshot.entries.len());
+            assert_eq!(
+                (snapshot.live, snapshot.ref_active, snapshot.pending),
+                (
+                    snapshot.entries.len(),
+                    snapshot.entries.len(),
+                    snapshot.entries.len()
+                )
+            );
+        }
+        for thread in threads {
+            thread.join().unwrap();
+        }
+        let snapshot = registry.lock().unwrap().snapshot().unwrap();
+        assert_eq!(snapshot.live, 0);
+        assert_eq!(snapshot.generation, 4 * 256 * 3);
+        assert!(snapshot.observation_valid);
+    }
+    #[test]
+    fn census_has_no_inline_pool_capacity_limit() {
+        let mut registry = Registry::new();
+        let status = Status {
+            state: State::Allocated,
+            ref_active: false,
+            pending: false,
+            closing: false,
+        };
+        for address in 1..=4096 {
+            registry.register(Kind::FilePoll, address, status);
+        }
+        let snapshot = registry.snapshot().unwrap();
+        assert!(snapshot.observation_valid);
+        assert_eq!(
+            (snapshot.live, snapshot.ref_active, snapshot.pending),
+            (4096, 0, 0)
+        );
+        for address in 1..=4096 {
+            registry.release(Kind::FilePoll, address);
+        }
+        assert_eq!(registry.snapshot().unwrap().live, 0);
+    }
+    #[test]
+    fn overflow_refuses_registration_and_invalidates_generation() {
+        let mut registry = Registry::new();
+        registry.next_id = u64::MAX;
+        registry.register(Kind::PoolJob, 1, Status::job(State::Queued));
+        assert!(registry.entries.is_empty());
+        assert!(!registry.valid);
+        registry.generation = u64::MAX;
+        registry.changed();
+        assert_eq!(registry.generation, u64::MAX);
+    }
+}

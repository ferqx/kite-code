--- /dev/null
+++ b/src/jsc/resource_census_binding.rs
@@ -0,0 +1,140 @@
+//! Private process-wide primitive observation. This is deliberately partial.
+use crate::{CallFrame, JSGlobalObject, JSValue, JsResult, bun_string_jsc::create_utf8_for_js};
+use bun_io::resource_census::{self, Kind, State};
+
+const BASE_REVISION: &[u8] = b"744846f844374847c902b5e7fd59b4342a51ef99";
+const UNCOVERED: &[&str] = &[
+    "timers",
+    "sockets-including-http-background-loop",
+    "workers",
+    "non-Job-requests-and-native-addons",
+    "windows-file-polls",
+];
+
+fn decimal(global: &JSGlobalObject, mut value: u64) -> JsResult<JSValue> {
+    // No intermediate heap allocation, and no lossy JavaScript Number cast.
+    let mut bytes = [0u8; 20];
+    let mut offset = bytes.len();
+    loop {
+        offset -= 1;
+        bytes[offset] = b'0' + (value % 10) as u8;
+        value /= 10;
+        if value == 0 {
+            break;
+        }
+    }
+    create_utf8_for_js(global, &bytes[offset..])
+}
+fn strings(global: &JSGlobalObject, values: &[&str]) -> JsResult<JSValue> {
+    JSValue::create_array_from_iter(global, values.iter(), |value| {
+        create_utf8_for_js(global, value.as_bytes())
+    })
+}
+fn kind_name(kind: Kind) -> &'static [u8] {
+    match kind {
+        Kind::PoolJob => b"PoolJob",
+        Kind::FilePoll => b"FilePoll",
+    }
+}
+fn state_name(state: State) -> &'static [u8] {
+    match state {
+        State::Allocated => b"allocated",
+        State::Queued => b"queued",
+        State::Running => b"running",
+        State::CompletionQueued => b"completionQueued",
+        State::Watching => b"watching",
+        State::Dormant => b"dormant",
+        State::Closing => b"closing",
+    }
+}
+
+#[crate::host_fn(export = "Bun__getResourceCensus")]
+pub fn get_resource_census(global: &JSGlobalObject, _frame: &CallFrame) -> JsResult<JSValue> {
+    // snapshot() releases its lock before any JS allocation or property write.
+    let snapshot = resource_census::snapshot();
+    let result = JSValue::create_empty_object(global, 13);
+    result.put(global, b"version", JSValue::js_number_from_int32(1));
+    result.put(
+        global,
+        b"baseRevision",
+        create_utf8_for_js(global, BASE_REVISION)?,
+    );
+    result.put(
+        global,
+        b"scope",
+        create_utf8_for_js(global, b"process-native-primitive-hooks")?,
+    );
+    result.put(global, b"coverageComplete", JSValue::from(false));
+    let Some(snapshot) = snapshot else {
+        result.put(global, b"observationValid", JSValue::from(false));
+        result.put(global, b"unknown", JSValue::from(true));
+        result.put(
+            global,
+            b"reason",
+            create_utf8_for_js(global, b"snapshot-allocation-failed")?,
+        );
+        result.put(global, b"uncovered", strings(global, UNCOVERED)?);
+        for key in [
+            b"generation".as_slice(),
+            b"entries",
+            b"live",
+            b"refActive",
+            b"pending",
+            b"closing",
+        ] {
+            result.put(global, key, JSValue::NULL);
+        }
+        return Ok(result);
+    };
+    result.put(global, b"generation", decimal(global, snapshot.generation)?);
+    result.put(
+        global,
+        b"observationValid",
+        JSValue::from(snapshot.observation_valid),
+    );
+    result.put(
+        global,
+        b"unknown",
+        JSValue::from(!snapshot.observation_valid),
+    );
+    result.put(
+        global,
+        b"reason",
+        if snapshot.observation_valid {
+            JSValue::NULL
+        } else {
+            create_utf8_for_js(global, b"native-observation-invalid")?
+        },
+    );
+    result.put(global, b"uncovered", strings(global, snapshot.uncovered)?);
+    let entries = JSValue::create_array_from_iter(global, snapshot.entries.iter(), |entry| {
+        let value = JSValue::create_empty_object(global, 7);
+        value.put(global, b"resourceId", decimal(global, entry.resource_id)?);
+        value.put(
+            global,
+            b"kind",
+            create_utf8_for_js(global, kind_name(entry.kind))?,
+        );
+        value.put(
+            global,
+            b"state",
+            create_utf8_for_js(global, state_name(entry.status.state))?,
+        );
+        value.put(global, b"live", JSValue::from(true));
+        value.put(global, b"refActive", JSValue::from(entry.status.ref_active));
+        value.put(global, b"pending", JSValue::from(entry.status.pending));
+        value.put(global, b"closing", JSValue::from(entry.status.closing));
+        Ok(value)
+    })?;
+    result.put(global, b"entries", entries);
+    // Counts, IDs and generations are decimal strings throughout this private ABI.
+    for (key, count) in [
+        (b"live".as_slice(), snapshot.live),
+        (b"refActive", snapshot.ref_active),
+        (b"pending", snapshot.pending),
+        (b"closing", snapshot.closing),
+    ] {
+        result.put(global, key, decimal(global, count as u64)?);
+    }
+    Ok(result)
+}

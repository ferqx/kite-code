{
  "name": "kite-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "agent": "bun run src/app/cli/index.ts",
    "test": "bun test",
    "test:real": "bun run tests/real-test-cli.ts",
    "test:mock": "bun test ./tests/mock-compaction.real.ts",
    "test:e2e": "bun test ./tests/e2e/",
    "tui": "bun run src/app/tui/index.tsx",
    "prod:tui": "NODE_ENV=production bun run src/app/tui/index.tsx",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "biome lint .",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/deepseek": "^1.1.3",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "gpt-tokenizer": "^3.4.0",
    "ink": "^7.1.0",
    "ink-scroll-list": "^0.4.1",
    "ink-text-input": "^6.0.0",
    "ink-virtual-list": "^0.2.3",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.6",
    "string-width": "^8.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0",
    "lefthook": "^2.1.9",
    "typescript": "^5.9.3"
  }
}

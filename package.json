{
  "name": "kite-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "scripts/release/source-terminal.ts",
  "workspaces": [
    "packages/ai",
    "packages/agent",
    "packages/client",
    "packages/ui",
    "apps/service",
    "apps/cli",
    "apps/desktop",
    "apps/web"
  ],
  "scripts": {
    "agent": "bun run scripts/release/entrypoints/cli.ts",
    "build": "bun run scripts/run-runtime-workspace-script.ts build",
    "test": "bun run scripts/run-default-tests.ts",
    "test:all": "bun run test",
    "test:mock": "bun test --parallel=1 --max-concurrency=1 apps/service/test/isolated/compression-configuration.test.ts apps/service/test/isolated/compression-automatic-configuration.test.ts packages/agent/test/isolated/context/compression.test.ts packages/agent/test/isolated/storage/context-compression-history-source.test.ts",
    "test:mcp:live": "bun run scripts/runtime/unified-mcp-live-smoke.ts",
    "test:e2e": "bun test --parallel=1 --max-concurrency=1 apps/service/test/isolated/paired.test.ts apps/service/test/isolated/lifecycle.test.ts apps/service/test/isolated/assembly-http.test.ts apps/service/test/isolated/http.test.ts packages/client/test/sse.test.ts packages/client/test/isolated/lifecycle.test.ts",
    "test:runtime:fault": "bun test --parallel=1 --max-concurrency=1 tests/isolated/unified-agent/unified-soak.test.ts tests/isolated/unified-agent/dispatch-recovery.test.ts packages/agent/test/isolated/recovery/crash.test.ts packages/agent/test/isolated/execution/owner-handoff.test.ts apps/service/test/isolated/process-cleanup-retention.test.ts apps/service/test/isolated/run-resume.test.ts",
    "test:runtime:soak": "bun run scripts/runtime/unified-soak.ts --profile=ci --output=dist/unified-evidence/soak-ci.json",
    "test:runtime:stdio": "bun test --parallel=1 --max-concurrency=1 packages/agent/test/isolated/mcp/stdio-port.test.ts apps/service/test/isolated/paired.test.ts apps/service/test/isolated/startup-frame.test.ts apps/service/test/isolated/lifecycle.test.ts apps/cli/test/stdio-grants.test.ts apps/cli/test/stdio-interactions.test.ts",
    "test:runtime:transport": "bun test --parallel=1 --max-concurrency=1 apps/service/test/isolated/http.test.ts apps/service/test/isolated/paired.test.ts apps/service/test/isolated/multi-service.test.ts apps/service/test/isolated/assembly-http.test.ts packages/client/test/sse.test.ts packages/client/test/browser.test.ts packages/client/test/isolated/lifecycle.test.ts",
    "test:tui:harness": "bun test --parallel=1 --max-concurrency=1 tests/isolated/unified-agent/unified-tui-runner.test.ts",
    "test:tui:integration": "bun run scripts/run-unified-tui-system-tests.ts",
    "test:tui:system": "bun run scripts/run-unified-tui-system-tests.ts",
    "tui": "bun run scripts/release/entrypoints/tui.ts",
    "server": "bun run scripts/development/ensure-web.ts",
    "web:dev": "bun run scripts/development/unified-web.ts",
    "cli:dev": "bun run scripts/development/unified-cli.ts",
    "tui:dev": "bun run scripts/development/unified-tui.ts",
    "prod:tui": "NODE_ENV=production bun run scripts/release/entrypoints/tui.ts",
    "release:terminal": "bun run scripts/release/terminal.ts",
    "release:build": "bun run scripts/release/unified.ts build",
    "release:verify": "bun run scripts/release/unified.ts verify",
    "release:smoke": "bun run scripts/release/unified.ts smoke",
    "release:install": "bun run scripts/release/unified.ts install",
    "release:smoke:execution": "bun run scripts/release/unified-platform-probe.ts",
    "typecheck": "tsc --noEmit && bun run scripts/run-runtime-workspace-script.ts typecheck",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "biome lint .",
    "check:core-boundary": "bun run scripts/check-unified-agent-boundary.ts",
    "check:unified-agent-boundary": "bun run scripts/check-unified-agent-boundary.ts",
    "generate:unified-api": "bun run scripts/generate-unified-api.ts",
    "check:unified-api": "bun run scripts/generate-unified-api.ts --check",
    "test:unified-agent": "bun run scripts/run-unified-tests.ts",
    "check:runtime-packages": "bun run scripts/check-unified-workspaces.ts",
    "check:agent-api-packages": "bun run scripts/generate-unified-api.ts --check",
    "check:test-ownership": "bun run scripts/check-test-ownership.ts",
    "check:pre-release-architecture": "bun run scripts/check-unified-agent-boundary.ts && bun run scripts/check-unified-workspaces.ts && bun run scripts/generate-unified-api.ts --check",
    "check:docs": "bun run scripts/check-docs.ts",
    "check:docs-impact": "bun run scripts/check-docs-impact.ts",
    "check:protected-branch": "bun run scripts/check-protected-branch.ts",
    "check:plan-evidence": "bun run scripts/check-plan-execution-matrix.ts",
    "desktop": "bun run scripts/release/native.ts launch",
    "test:desktop:native": "bun test --parallel=1 --max-concurrency=1 apps/desktop/test/isolated/native-bundle.test.ts apps/desktop/test/isolated/native-process.test.ts apps/desktop/test/isolated/native-file-recovery-paired.test.ts",
    "test:desktop:window": "bun test --parallel=1 --max-concurrency=1 tests/isolated/unified-agent/native-install-lifecycle.test.ts",
    "release:native": "bun run scripts/release/native.ts",
    "test:shell:native": "bun test --parallel=1 --max-concurrency=1 packages/agent/test/isolated/jobs/confined-shell.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@clack/prompts": "^1.7.0",
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/keyring": "1.3.0",
    "@types/jsdom": "^28.0.3",
    "@types/turndown": "^5.0.6",
    "ai": "^7.0.19",
    "ajv": "^8.17.1",
    "chalk": "^5.6.2",
    "gpt-tokenizer": "^3.4.0",
    "ink": "^7.1.1",
    "ink-scroll-list": "^0.4.1",
    "ink-syntax-highlight": "^2.0.2",
    "ink-text-input": "^6.0.0",
    "ink-virtual-list": "^0.2.3",
    "jsdom": "^29.1.1",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.6",
    "string-width": "^8.2.0",
    "turndown": "^7.2.4",
    "yaml": "^2.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@kite-ai/agent": "workspace:*",
    "@kite-ai/ai": "workspace:*",
    "@kite-ai/client": "workspace:*",
    "@kite-ai/cli": "workspace:*",
    "@kite-ai/desktop": "workspace:*",
    "@kite-ai/service": "workspace:*",
    "@kite-ai/ui": "workspace:*",
    "@kite-ai/web": "workspace:*",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@xterm/headless": "6.0.0",
    "ink-testing-library": "^4.0.0",
    "lefthook": "^2.1.9",
    "react-dom": "19.2.7",
    "typescript": "^5.9.3"
  },
  "patchedDependencies": {
    "ink-virtual-list@0.2.3": "patches/ink-virtual-list@0.2.3.patch"
  }
}

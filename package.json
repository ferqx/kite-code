{
  "name": "kite-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "apps/kite-cli/src/index.ts",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "agent": "bun run scripts/release/entrypoints/cli.ts",
    "build": "bun run scripts/run-runtime-workspace-script.ts build",
    "test": "bun run scripts/run-default-tests.ts",
    "test:all": "bun run test && bun run test:tui:system",
    "test:mock": "bun test ./apps/kite-service/test/runtime/context-compaction-e2e.test.ts",
    "test:mcp:live": "KITE_RUN_LIVE_MCP_SMOKE=1 bun run tests/e2e/live/mcp/langchain-docs.live.ts",
    "test:model:live": "bun run tests/e2e/live/model/context-compaction.live.ts",
    "test:e2e": "bun test --parallel=1 --max-concurrency=1 tests/e2e/local/",
    "test:runtime:fault": "bun test tests/qualification/runtime/fault-injection.test.ts tests/qualification/runtime/fault-soak-report.test.ts tests/qualification/runtime/fault-soak-runner.test.ts tests/qualification/runtime/fault-soak-qualification-verifier.test.ts",
    "test:runtime:soak": "bun run scripts/runtime/run-fault-soak.ts --profile=ci",
    "test:runtime:stdio": "bun test --parallel=1 --max-concurrency=1 apps/kite-service/test/isolated/runtime-stdio-carrier.test.ts apps/kite-service/test/isolated/runtime-server-composition.test.ts packages/kite-local-runtime/test/bun-stdio-child-transport.test.ts",
    "test:runtime:websocket": "bun test --parallel=1 --max-concurrency=1 apps/kite-service/test/isolated/local-bootstrap-auth.test.ts apps/kite-service/test/isolated/development-loopback-carrier.test.ts packages/kite-local-runtime/test/bun-websocket-transport.test.ts apps/kite-service/test/isolated/development-websocket-runtime-client.test.ts apps/kite-service/test/isolated/development-runtime-reference.test.ts",
    "test:runtime:transport": "bun test --parallel=1 --max-concurrency=1 apps/kite-service/test/isolated/runtime-transport-conformance.test.ts",
    "test:sandbox:smoke:native": "bun test --parallel=1 --max-concurrency=1 tests/qualification/sandbox-executor.test.ts tests/qualification/sandbox-bwrap-executor.test.ts",
    "test:tui:harness": "bun test --parallel=1 --max-concurrency=1 tests/tui-system/harness/",
    "test:tui:integration": "bun run scripts/run-tui-system-tests.ts",
    "test:tui:system": "bun run scripts/run-tui-system-tests.ts",
    "test:tui:smoke:native": "KITE_RUN_NATIVE_SANDBOX_SMOKE=1 bun test --parallel=1 --max-concurrency=1 tests/tui-system/smoke/native-sandbox.test.ts",
    "test:tui:system:core": "bun run scripts/run-tui-system-tests.ts startup input multi-turn interrupt approval-escape slash-commands session-lifecycle session-switch session-persistence interrupt-resume error-recovery tool-approve ask-user-esc tool-parse-error",
    "tui": "bun run scripts/release/entrypoints/tui.ts",
    "prod:tui": "NODE_ENV=production bun run scripts/release/entrypoints/tui.ts",
    "release:build": "bun run scripts/release/build-oss-candidate.ts",
    "release:verify": "bun run scripts/release/verify-oss-candidate.ts",
    "release:smoke": "bun run scripts/release/smoke-oss-candidate.ts",
    "release:install": "bun run scripts/release/install-oss-candidate.ts",
    "release:contract:build": "bun run scripts/release/build-artifact.ts",
    "release:contract:verify": "bun run scripts/release/verify-artifact.ts",
    "release:contract:smoke": "bun run scripts/release/bootstrap-verifier.ts",
    "release:smoke:execution": "bun run scripts/release/execution-boundary-smoke.ts",
    "release:gate:foundation": "bun run scripts/release/foundation-gate.ts",
    "typecheck": "tsc --noEmit && bun run scripts/run-runtime-workspace-script.ts typecheck",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "biome lint .",
    "check:core-boundary": "bun run scripts/check-core-boundary.ts",
    "check:runtime-packages": "bun run scripts/check-runtime-packages.ts",
    "check:test-ownership": "bun run scripts/check-test-ownership.ts",
    "check:pre-release-architecture": "bun run scripts/check-pre-release-architecture.ts",
    "check:compaction-legacy": "bun run scripts/check-compaction-legacy.ts",
    "check:docs": "bun run scripts/check-docs.ts",
    "check:docs-impact": "bun run scripts/check-docs-impact.ts",
    "check:protected-branch": "bun run scripts/check-protected-branch.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@clack/prompts": "^1.7.0",
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/keyring": "1.3.0",
    "@types/jsdom": "^28.0.3",
    "@types/turndown": "^5.0.6",
    "ai": "^7.0.19",
    "ajv": "^8.17.1",
    "chalk": "^5.6.2",
    "gpt-tokenizer": "^3.4.0",
    "ink": "^7.1.1",
    "ink-scroll-list": "^0.4.1",
    "ink-syntax-highlight": "^2.0.2",
    "ink-text-input": "^6.0.0",
    "ink-virtual-list": "^0.2.3",
    "jsdom": "^29.1.1",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.6",
    "string-width": "^8.2.0",
    "turndown": "^7.2.4",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@kite-ai/agent-kernel": "workspace:*",
    "@kite-ai/builtin-runtime": "workspace:*",
    "@kite-ai/kite-app-contract": "workspace:*",
    "@kite-ai/kite-local-runtime": "workspace:*",
    "@kite-ai/runtime-client": "workspace:*",
    "@kite-ai/runtime-contract": "workspace:*",
    "@kite-ai/runtime-host": "workspace:*",
    "@kite-ai/runtime-protocol": "workspace:*",
    "@kite-ai/runtime-server": "workspace:*",
    "@kite-ai/runtime-spi": "workspace:*",
    "@kite-ai/runtime-storage-sqlite": "workspace:*",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@xterm/headless": "6.0.0",
    "ink-testing-library": "^4.0.0",
    "lefthook": "^2.1.9",
    "typescript": "^5.9.3"
  }
}

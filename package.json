{
  "name": "kite-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "scripts/release/source-terminal.ts",
  "workspaces": [
    "packages/trajectory",
    "packages/trace-extension-sdk",
    "packages/ai",
    "packages/agent",
    "packages/client",
    "packages/ui",
    "apps/service",
    "apps/cli",
    "apps/desktop",
    "apps/web"
  ],
  "scripts": {
    "agent": "node --import ./scripts/tooling/register.mjs scripts/release/entrypoints/cli.ts",
    "build": "bun --no-config --no-env-file --no-install ./scripts/run-runtime-workspace-script.ts build",
    "test": "node --import ./scripts/tooling/register.mjs scripts/run-default-tests.ts",
    "test:all": "bun run test",
    "test:fast": "bun --no-config --no-env-file --no-install ./tests/fast/run.mjs",
    "test:mock": "node --import ./scripts/tooling/register.mjs ./scripts/run-test-files.ts --parallel=1 --max-concurrency=1 apps/service/test/isolated/compression-configuration.test.ts apps/service/test/isolated/compression-automatic-configuration.test.ts packages/agent/test/isolated/context/compression.test.ts packages/agent/test/isolated/storage/context-compression-history-source.test.ts",
    "test:mcp:live": "node --import ./scripts/tooling/register.mjs scripts/runtime/unified-mcp-live-smoke.ts",
    "test:model:tools:live": "node --import ./scripts/tooling/register.mjs tests/e2e/live/model/model-tools.live.ts",
    "test:model:pdf:live": "node --import ./scripts/tooling/register.mjs tests/e2e/live/model/pdf-vision.live.ts",
    "test:model:image:live": "node --import ./scripts/tooling/register.mjs tests/e2e/live/model/image-vision.live.ts",
    "test:model:collaboration:live": "node --import ./scripts/tooling/register.mjs tests/e2e/live/model/collaboration.live.ts",
    "test:e2e": "node --import ./scripts/tooling/register.mjs ./scripts/run-test-files.ts --parallel=1 --max-concurrency=1 apps/service/test/isolated/paired.test.ts apps/service/test/isolated/lifecycle.test.ts apps/service/test/isolated/assembly-http.test.ts apps/service/test/isolated/http.test.ts packages/client/test/sse.test.ts packages/client/test/isolated/lifecycle.test.ts",
    "test:runtime:fault": "node --import ./scripts/tooling/register.mjs ./scripts/run-test-files.ts --parallel=1 --max-concurrency=1 tests/isolated/unified-agent/unified-soak.test.ts tests/isolated/unified-agent/dispatch-recovery.test.ts packages/agent/test/isolated/recovery/crash.test.ts packages/agent/test/isolated/execution/owner-handoff.test.ts apps/service/test/isolated/process-cleanup-retention.test.ts apps/service/test/isolated/run-resume.test.ts",
    "test:runtime:soak": "node --expose-gc --import ./scripts/tooling/register.mjs scripts/runtime/unified-soak.ts --profile=ci --output=dist/unified-evidence/soak-ci.json",
    "test:runtime:stdio": "node --import ./scripts/tooling/register.mjs ./scripts/run-test-files.ts --parallel=1 --max-concurrency=1 packages/agent/test/isolated/mcp/stdio-port.test.ts apps/service/test/isolated/paired.test.ts apps/service/test/isolated/startup-frame.test.ts apps/service/test/isolated/lifecycle.test.ts apps/cli/test/stdio-grants.test.ts apps/cli/test/stdio-interactions.test.ts packages/agent/test/isolated/mcp/linux-stdio-port.test.ts packages/agent/test/isolated/mcp/linux-owned-program.test.ts packages/agent/test/isolated/mcp/windows-stdio-port.test.ts && node --import ./scripts/tooling/register.mjs ./scripts/run-test-files.ts --parallel=1 --max-concurrency=1 apps/service/test/isolated/mcp-source-packaged-default.test.ts",
    "test:runtime:transport": "node --import ./scripts/tooling/register.mjs ./scripts/run-test-files.ts --parallel=1 --max-concurrency=1 apps/service/test/isolated/http.test.ts apps/service/test/isolated/paired.test.ts apps/service/test/isolated/multi-service.test.ts apps/service/test/isolated/assembly-http.test.ts packages/client/test/sse.test.ts packages/client/test/browser.test.ts packages/client/test/isolated/lifecycle.test.ts",
    "test:tui:harness": "node --import ./scripts/tooling/register.mjs ./scripts/run-test-files.ts --parallel=1 --max-concurrency=1 tests/isolated/unified-agent/unified-tui-runner.test.ts",
    "test:tui:integration": "node --import ./scripts/tooling/register.mjs scripts/run-unified-tui-system-tests.ts",
    "test:tui:system": "node --import ./scripts/tooling/register.mjs scripts/run-unified-tui-system-tests.ts",
    "tui": "node --import ./scripts/tooling/register.mjs scripts/release/entrypoints/tui.ts",
    "server": "node --import ./scripts/tooling/register.mjs scripts/development/ensure-web.ts",
    "web:dev": "node --import ./scripts/tooling/register.mjs scripts/development/unified-web.ts",
    "cli:dev": "node --import ./scripts/tooling/register.mjs scripts/development/unified-cli.ts",
    "tui:dev": "node --import ./scripts/tooling/register.mjs scripts/development/unified-tui.ts",
    "prod:tui": "node --import ./scripts/tooling/register.mjs scripts/release/entrypoints/production-tui.ts",
    "release:terminal": "node --import ./scripts/tooling/register.mjs scripts/release/terminal.ts",
    "release:build": "node --import ./scripts/tooling/register.mjs scripts/release/unified.ts build",
    "release:macos-dmg": "node --import ./scripts/tooling/register.mjs scripts/release/unified.ts macos-dmg",
    "release:windows-setup": "node --import ./scripts/tooling/register.mjs scripts/release/unified.ts windows-setup",
    "prepare:node-inputs": "node --import ./scripts/tooling/register.mjs scripts/release/node-inputs.ts",
    "prepare:node-runtime": "node --import ./scripts/tooling/register.mjs scripts/development/prepare-node-runtime.ts",
    "release:verify": "node --import ./scripts/tooling/register.mjs scripts/release/unified.ts verify",
    "release:smoke": "node --import ./scripts/tooling/register.mjs scripts/release/unified.ts smoke",
    "release:install": "node --import ./scripts/tooling/register.mjs scripts/release/unified.ts install",
    "release:smoke:execution": "node --import ./scripts/tooling/register.mjs scripts/release/unified-platform-probe.ts",
    "typecheck": "node node_modules/typescript/bin/tsc -b tsconfig.typecheck.json",
    "format": "node node_modules/@biomejs/biome/bin/biome check --write .",
    "format:check": "node node_modules/@biomejs/biome/bin/biome check .",
    "lint": "node node_modules/@biomejs/biome/bin/biome lint .",
    "check:core-boundary": "node --import ./scripts/tooling/register.mjs scripts/check-unified-agent-boundary.ts",
    "check:unified-agent-boundary": "node --import ./scripts/tooling/register.mjs scripts/check-unified-agent-boundary.ts",
    "generate:unified-api": "node --import ./scripts/tooling/register.mjs scripts/generate-unified-api.ts",
    "check:unified-api": "node --import ./scripts/tooling/register.mjs scripts/generate-unified-api.ts --check",
    "test:unified-agent": "node --import ./scripts/tooling/register.mjs scripts/run-unified-tests.ts",
    "check:runtime-packages": "node --import ./scripts/tooling/register.mjs scripts/check-unified-workspaces.ts",
    "check:agent-api-packages": "node --import ./scripts/tooling/register.mjs scripts/generate-unified-api.ts --check",
    "check:test-ownership": "node --import ./scripts/tooling/register.mjs scripts/check-test-ownership.ts",
    "check:pre-release-architecture": "node --import ./scripts/tooling/register.mjs scripts/check-unified-workspaces.ts && node --import ./scripts/tooling/register.mjs scripts/generate-unified-api.ts --check",
    "check:docs": "node --import ./scripts/tooling/register.mjs scripts/check-docs.ts",
    "check:docs-impact": "node --import ./scripts/tooling/register.mjs scripts/check-docs-impact.ts",
    "check:protected-branch": "node --import ./scripts/tooling/register.mjs scripts/check-protected-branch.ts",
    "check:plan-evidence": "node --import ./scripts/tooling/register.mjs scripts/check-plan-execution-matrix.ts",
    "desktop": "node --import ./scripts/tooling/register.mjs scripts/release/native.ts launch",
    "desktop:dev": "node --import ./scripts/tooling/register.mjs scripts/development/unified-desktop.ts",
    "test:desktop:native": "node --import ./scripts/tooling/register.mjs ./scripts/run-test-files.ts --parallel=1 --max-concurrency=1 apps/desktop/test/isolated/native-bundle.test.ts apps/desktop/test/isolated/native-process.test.ts apps/desktop/test/isolated/native-file-recovery-paired.test.ts",
    "test:desktop:window": "node --import ./scripts/tooling/register.mjs ./scripts/run-test-files.ts --parallel=1 --max-concurrency=1 tests/isolated/unified-agent/native-install-lifecycle.test.ts",
    "release:native": "node --import ./scripts/tooling/register.mjs scripts/release/native.ts",
    "test:shell:native": "node --import ./scripts/tooling/register.mjs ./scripts/run-test-files.ts --parallel=1 --max-concurrency=1 packages/agent/test/isolated/jobs/confined-shell.test.ts",
    "build:files-native": "node --import ./scripts/tooling/register.mjs packages/agent/scripts/build-native-files.ts packages/agent/src",
    "postinstall": "bun run build:files-native"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@clack/prompts": "^1.7.0",
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/keyring": "1.3.0",
    "@types/jsdom": "^28.0.3",
    "@types/turndown": "^5.0.6",
    "ai": "^7.0.19",
    "ajv": "^8.17.1",
    "chalk": "^5.6.2",
    "gpt-tokenizer": "^3.4.0",
    "ink": "^7.1.1",
    "ink-scroll-list": "^0.4.1",
    "ink-syntax-highlight": "^2.0.2",
    "ink-text-input": "^6.0.0",
    "ink-virtual-list": "^0.2.3",
    "jsdom": "^29.1.1",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.6",
    "string-width": "^8.2.0",
    "turndown": "^7.2.4",
    "yaml": "^2.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@kite-ai/agent": "workspace:*",
    "@kite-ai/ai": "workspace:*",
    "@kite-ai/client": "workspace:*",
    "@kite-ai/cli": "workspace:*",
    "@kite-ai/desktop": "workspace:*",
    "@kite-ai/service": "workspace:*",
    "@kite-ai/ui": "workspace:*",
    "@kite-ai/web": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@xterm/headless": "6.0.0",
    "ink-testing-library": "^4.0.0",
    "lefthook": "^2.1.9",
    "react-dom": "19.2.7",
    "typescript": "^5.9.3",
    "@kite-ai/trajectory": "workspace:*",
    "@kite-ai/trace-extension-sdk": "workspace:*",
    "@types/node": "26.0.1",
    "esbuild": "0.28.2",
    "expect": "30.5.2",
    "jest-mock": "30.5.2"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@radix-ui/react-scroll-area@1.2.18": "patches/@radix-ui%2Freact-scroll-area@1.2.18.patch",
    "ink-virtual-list@0.2.3": "patches/ink-virtual-list@0.2.3.patch"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "engines": {
    "node": "26.13.1"
  },
  "imports": {
    "#kite-test": "./scripts/tooling/test.ts"
  }
}

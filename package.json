{
  "name": "kite-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "agent": "bun run src/app/cli/index.ts",
    "test": "bun test --path-ignore-patterns='tests/tui-system/**' --path-ignore-patterns='tests/pty-spike/**'",
    "test:mock": "bun test ./tests/mock-compaction.real.ts",
    "test:e2e": "bun test --parallel=1 --max-concurrency=1 tests/tui-system/scenarios/",
    "test:tui:integration": "bun test --parallel=1 --max-concurrency=1 tests/tui-system/scenarios/",
    "test:tui:system": "bun test --parallel=1 --max-concurrency=1 tests/tui-system/scenarios/",
    "test:tui:system:core": "bun test --parallel=1 --max-concurrency=1 tests/tui-system/scenarios/startup.test.ts tests/tui-system/scenarios/input.test.ts tests/tui-system/scenarios/multi-turn.test.ts tests/tui-system/scenarios/interrupt.test.ts tests/tui-system/scenarios/approval.test.ts tests/tui-system/scenarios/approval-escape.test.ts tests/tui-system/scenarios/ask-user.test.ts tests/tui-system/scenarios/slash-commands.test.ts tests/tui-system/scenarios/session-lifecycle.test.ts tests/tui-system/scenarios/session-switch.test.ts tests/tui-system/scenarios/session-persistence.test.ts tests/tui-system/scenarios/interrupt-resume.test.ts tests/tui-system/scenarios/error-recovery.test.ts tests/tui-system/scenarios/tool-approve.test.ts tests/tui-system/scenarios/ask-user-esc.test.ts tests/tui-system/scenarios/idle-summary.test.ts tests/tui-system/scenarios/long-message.test.ts tests/tui-system/scenarios/tool-parse-error.test.ts",
    "tui": "bun run src/app/tui/index.tsx",
    "prod:tui": "NODE_ENV=production bun run src/app/tui/index.tsx",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "biome lint .",
    "web": "bun run src/web-server/index.ts",
    "web:dev": "BUN_ENV=development bun --watch run src/web-server/index.ts",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.10",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@types/jsdom": "^28.0.3",
    "@types/turndown": "^5.0.6",
    "ai": "^7.0.19",
    "gpt-tokenizer": "^3.4.0",
    "hono": "^4.12.29",
    "ink": "^7.1.0",
    "ink-scroll-list": "^0.4.1",
    "ink-text-input": "^6.0.0",
    "ink-virtual-list": "^0.2.3",
    "jsdom": "^29.1.1",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.6",
    "string-width": "^8.2.0",
    "turndown": "^7.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0",
    "lefthook": "^2.1.9",
    "typescript": "^5.9.3"
  }
}
